{
  "name": "mi-web-escolar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:decoraciones": "node scripts/sync-decoraciones.mjs",
    "gen:materias": "node scripts/gen-materias-list.mjs",
    "gen:registros": "node scripts/gen-registros-list.mjs",
    "gen:tablas": "node scripts/gen-tablas-desde-supabase.mjs",
    "test:compilar": "node scripts/compilar-suites.mjs",
    "gen:matriz": "node scripts/gen-matriz-permisos.mjs",
    "gen:invariantes": "node scripts/gen-invariantes.mjs",
    "gen:rumbo": "node scripts/gen-rumbo.mjs",
    "test:suites": "node scripts/correr-todas-las-suites.mjs",
    "test:permisos": "node scripts/test-permisos.mjs && node scripts/test-auditoria-permisos.mjs",
    "test:ci": "node scripts/correr-todas-las-suites.mjs && node scripts/gen-invariantes.mjs --check && node scripts/gen-rumbo.mjs --check && npm run verificar:estado && npm run verificar:docs",
    "verificar:estado": "node scripts/verificar-estado-actual.mjs",
    "verificar:docs": "node scripts/verificar-docs.mjs",
    "panel": "node scripts/gen-estado.mjs && node scripts/gen-panel.mjs",
    "panel:json": "node scripts/gen-estado.mjs --sin-historico --salida=.panel/estado.json",
    "informe": "node scripts/gen-informe.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "browser-image-compression": "^2.0.2",
    "cloudinary": "^2.10.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
